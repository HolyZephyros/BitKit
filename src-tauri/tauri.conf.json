{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BitKit",
  "version": "2.0.0",
  "identifier": "com.bitkit.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "BitKit",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0a0a0f",
        "visible": false,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../resources/bin/*": "bin/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
